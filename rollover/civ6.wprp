<?xml version="1.0" encoding="utf-8"?>
<!-- Profil WPR des présentations DXGI : un événement Present_Start / Present_Stop par image, qui
     donne le temps d'image et le temps passé bloqué dans Present. Beaucoup plus léger que le profil
     intégré GPU, qui trace aussi chaque paquet DMA du noyau graphique. Utilisé par capture.ps1. -->
<WindowsPerformanceRecorder Version="1.0" Author="Civ6BetterGameDLLs">
  <Profiles>
    <EventCollector Id="EC_Frames" Name="Civ6 Frames">
      <BufferSize Value="256"/>
      <Buffers Value="64"/>
    </EventCollector>
    <!-- Microsoft-Windows-DXGI, mot-clé Events (0x2) : Present (42, 43) et PresentMultiplaneOverlay (55, 56). -->
    <EventProvider Id="EP_DXGI" Name="ca11c036-0102-4a2d-a6ad-f03cfed5d3c9" Level="5">
      <Keywords>
        <Keyword Value="0x2"/>
      </Keywords>
    </EventProvider>
    <!-- Microsoft-Windows-Kernel-Network, mots-clés IPv4 (0x10) et IPv6 (0x20) : un événement par
         paquet UDP ou segment TCP, avec le pid et la taille. Donne la cadence réelle des paquets du
         multijoueur, que la boucle P2P du jeu va chercher chez steam.exe. -->
    <EventProvider Id="EP_Net" Name="7dd42a49-5329-4832-8dfd-43d979153a88" Level="4">
      <Keywords>
        <Keyword Value="0x30"/>
      </Keywords>
    </EventProvider>
    <Profile Id="Frames.Verbose.File" Name="Frames" Description="Présentations DXGI et trafic réseau de Civ6"
             LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <EventCollectorId Value="EC_Frames">
          <EventProviders>
            <EventProviderId Value="EP_DXGI"/>
            <EventProviderId Value="EP_Net"/>
          </EventProviders>
        </EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
